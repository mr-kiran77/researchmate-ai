# ResearchMate AI — Backend Environment Configuration
# Copy this file to backend/.env and fill in your API keys.
# NEVER expose secret API keys in frontend code or commit .env files.

# Primary AI Provider ("gemini" | "openai" | "auto")
LLM_PROVIDER=auto

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional OpenAI API (https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Tavily Web Search API (https://tavily.com/)
# Note: ResearchMate AI also searches live academic & reference sources (OpenAlex, arXiv, Wikipedia, DuckDuckGo)
# even when TAVILY_API_KEY is unset, and automatically adds Tavily web search when configured.
TAVILY_API_KEY=

# Optional Related Images APIs (swap in your own keys anytime)
# Works out-of-the-box with free Wikipedia/Wikimedia Commons/Openverse + topic-relevant SVG fallbacks when empty.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Application & Database
DATABASE_PATH=backend/data/researchmate.db
UPLOAD_DIR=backend/data/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
